{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_COST_WARNINGS": "1"
  },
  "model": "opus[1m]",
  "theme": "custom:catppuccin",
  "effortLevel": "auto",
  "defaultMode": "auto",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "NotebookRead",
      "Write",
      "Edit",
      "NotebookEdit",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "Skill",
      "ToolSearch",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "CronList"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(~/.ssh/*)",
      "Edit(~/.ssh/*)",
      "Read(~/.gnupg/*)",
      "Edit(~/.gnupg/*)",
      "Read(~/.aws/credentials)",
      "Edit(~/.aws/credentials)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(~/.kube/config)",
      "Edit(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Bash(*~/.ssh/id_rsa)",
      "Bash(*~/.ssh/id_ecdsa)",
      "Bash(*~/.ssh/id_ecdsa_sk)",
      "Bash(*~/.ssh/id_ed25519)",
      "Bash(*~/.ssh/id_ed25519_sk)",
      "Bash(*~/.ssh/id_dsa)",
      "Bash(*~/.ssh/config*)",
      "Bash(*~/.gnupg/private*)",
      "Bash(*~/.aws/credentials*)",
      "Bash(*~/.claude/.credentials*)",
      "Bash(*~/.kube/config*)",
      "Bash(*~/.docker/config.json*)",
      "Bash(*~/.netrc*)",
      "Bash(*~/.config/gh/hosts.yml*)",
      "Bash(bw get *)",
      "Bash(bw list *)",
      "Bash(bw export*)",
      "Bash(bw export --*)",
      "Bash(op read *)",
      "Bash(op item get *)",
      "Bash(op document get *)",
      "Bash(op item edit *)",
      "Bash(op vault export*)",
      "Bash(*$HOME/.ssh/id_rsa*)",
      "Bash(*$HOME/.ssh/id_ed25519*)",
      "Bash(*$HOME/.ssh/id_ecdsa*)",
      "Bash(*$HOME/.aws/credentials*)",
      "Bash(*$HOME/.claude/.credentials*)",
      "Bash(*/Users/ben/.ssh/id_rsa*)",
      "Bash(*/Users/ben/.ssh/id_ed25519*)",
      "Bash(*/Users/ben/.aws/credentials*)",
      "Bash(*/Users/ben/.claude/.credentials*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git clean -f*)",
      "Bash(git clean -f)",
      "Bash(git branch -D *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh release delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue close *)",
      "Bash(gh issue lock *)",
      "Bash(gh issue delete *)",
      "Bash(gh run cancel *)",
      "Bash(gh workflow disable *)",
      "Bash(gh cache delete *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable delete *)",
      "Bash(gh label delete *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api -X DELETE *)",
      "Bash(kubectl delete *)",
      "Bash(terraform destroy*)",
      "Bash(helm uninstall *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm *)",
      "Bash(docker network rm *)",
      "Bash(pip install *)",
      "Bash(npm install -g *)",
      "Bash(cargo install *)",
      "Bash(go install *)",
      "Bash(curl * -X POST*)",
      "Bash(curl * -X PUT*)",
      "Bash(curl * -X DELETE*)",
      "Bash(curl * -X PATCH*)",
      "Bash(curl * --request POST*)",
      "Bash(curl * --request PUT*)",
      "Bash(curl * --request DELETE*)",
      "Bash(curl * -d *)",
      "Bash(curl * --data*)",
      "Bash(wget --post-*)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(git config *)",
      "Bash(git filter-repo*)",
      "Bash(git filter-branch*)",
      "Bash(git rebase -i*)",
      "Bash(git push origin main*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(npm publish*)",
      "Bash(cargo publish*)",
      "Bash(twine upload*)",
      "Bash(gem push*)",
      "Bash(gh api * -X POST*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api * -X PATCH*)",
      "Bash(gh api --method POST*)",
      "Bash(gh api --method PUT*)",
      "Bash(gh api --method PATCH*)",
      "CronCreate",
      "CronDelete",
      "RemoteTrigger",
      "mcp__*__*delete*",
      "mcp__*__*remove*",
      "mcp__*__*sync*",
      "mcp__*__*deploy*",
      "mcp__*__*apply*",
      "mcp__*__*patch*",
      "mcp__*__*write*"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "rtk hook claude" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node \"$HOME/.hindsight/coding-agents/dist/claude-sessionstart-hook.js\"", "timeout": 30 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node \"$HOME/.hindsight/coding-agents/dist/claude-hook.js\"", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$HOME/.hindsight/coding-agents/dist/claude-stop-hook.js\"", "timeout": 60 }]
      }
    ]
  }
}
